# Application
APP_NAME=TaskForge
APP_ENV=development
DEBUG=false

# PostgreSQL
POSTGRES_DB=taskforge_db
POSTGRES_USER=taskforge_user
POSTGRES_PASSWORD=replace_with_a_local_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5436

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://taskforge_user:replace_with_a_local_secret@localhost:5436/taskforge_db

# Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
